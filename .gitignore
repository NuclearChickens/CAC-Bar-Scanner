# PyInstaller intermediate build state — only dist/*.exe is shipped.
build/
*.spec.bak

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Runtime data created by the app on first run
audit.log
scan_log.json
settings.json
backups/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# PyInstaller output dir — the shipped binary is committed at the repo root
dist/
# Intermediate file written by build_guide_pdf.sh
_guide_print.html
